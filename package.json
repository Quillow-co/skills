{
  "name": "@quillow/skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "check": "npm run format:check && npm run check:build && npm test"
  },
  "dependencies": {
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
